{
  "name": "hachimi-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-rive-wasm.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/sync-rive-wasm.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx,.mjs --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "check:mentions": "node scripts/check-copy-mentions.mjs",
    "check:canon": "python3 ../hachimi-ios/scripts/copy-canon-gate.py --only web --require-sibling",
    "check:copy": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/count-copy.mjs",
    "pretest:orb": "node scripts/sync-rive-wasm.mjs",
    "test:orb": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/orb-asset.test.mjs",
    "test:platform": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/platform.test.mjs",
    "legal:sync": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal-sync.mjs",
    "legal:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/legal-sync.mjs --check",
    "llms:build": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-llms.mjs",
    "llms:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-llms.mjs --check",
    "test:dates": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/page-dates.test.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:orb && npm run test:platform && npm run legal:check && npm run llms:check && npm run test:dates && npm run check:mentions && npm run check:copy && npm run check:canon && npm run build"
  },
  "dependencies": {
    "@rive-app/webgl2": "2.42.2",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.52.0",
    "marked": "^18.0.14",
    "motion": "^14.0.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
